; Engine configuration file.
; It's stored in a custom format, and you should not edit it manually.
; But for project bootstrap, we can write it directly.

[application]
config/name="Letter Rouge"
config/description="A Balatro-like deckbuilding roguelite where you match key cap letters to monster words"
run/main_scene="res://scenes/GameRoot.tscn"
config/features=PackedStringArray("4.3")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]
pointing/emulate_touch_from_mouse=true
